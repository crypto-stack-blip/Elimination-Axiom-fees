{
  "name": "tollfree",
  "version": "0.4.2",
  "description": "Zero-platform-fee execution for AXIOM-routed Solana swaps. Rebuilds the swap at the settlement layer and drops the assembler's fee instrument.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "tollfree": "dist/src/index.js"
  },
  "main": "dist/src/index.js",
  "files": [
    "dist",
    "fixtures",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "demo": "node dist/src/index.js demo",
    "test": "node --test dist/test/*.test.js",
    "fixtures": "node dist/scripts/make-fixtures.js",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@solana/web3.js": "^1.95.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "typescript": "^5.6.0"
  }
}
